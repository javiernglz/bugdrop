{
  "name": "bugdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Cyber Range: Bugdrop + Mini-SOC",
  "scripts": {
    "dev": "npx concurrently -n BACKEND,SHOP,SOC -c red,blue,magenta \"npm run dev:backend\" \"npm run dev:shop\" \"npm run dev:soc\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:shop": "cd frontend-shop && npm run dev",
    "dev:soc": "cd frontend-soc && npm run dev",
    "seed": "cd backend && npm run seed",
    "install:all": "npm install && cd backend && npm install && cd ../frontend-shop && npm install && cd ../frontend-soc && npm install",
    "test": "node tests/test_challenges.js",
    "test:step7": "node tests/test_step7.js",
    "test:bot": "node tests/test_bot.js"
  },
  "devDependencies": {
    "@playwright/test": "1.43.0",
    "concurrently": "^9.1.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io-client": "^4.8.4"
  },
  "keywords": [
    "ctf",
    "bug-bounty",
    "vulnerable-app",
    "docker",
    "soc",
    "cybersecurity"
  ]
}