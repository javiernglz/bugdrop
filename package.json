{
  "name": "bugdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Cyber Range: Bugdrop + Mini-SOC",
  "scripts": {
    "dev": "npx concurrently -n BACKEND,SHOP,SOC -c red,blue,magenta \"npm run dev:backend\" \"npm run dev:shop\" \"npm run dev:soc\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:shop": "cd frontend-shop && npm run dev",
    "dev:soc": "cd frontend-soc && npm run dev",
    "seed": "cd backend && npm run seed",
    "install:all": "cd backend && npm install && cd ../frontend-shop && npm install && cd ../frontend-soc && npm install",
    "test": "node tests/test_challenges.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ctf",
    "bug-bounty",
    "vulnerable-app",
    "docker",
    "soc",
    "cybersecurity"
  ]
}